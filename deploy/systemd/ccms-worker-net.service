[Unit]
Description=CCMS Celery worker (net queue: ping/SNMP - cheap, high concurrency)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ccms
Group=ccms
WorkingDirectory=/opt/ccms/backend
EnvironmentFile=/opt/ccms/.env
ExecStart=/opt/ccms/backend/.venv/bin/celery -A ccms.celery_app worker -Q net -c 20 -l info -n net@localhost
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
