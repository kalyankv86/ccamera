# Initial HTTP-only site. Run `sudo certbot --nginx -d YOUR_DOMAIN` after
# this is enabled - certbot rewrites this file in place to add the TLS
# server block, the 443 listener, and the 80->443 redirect. Don't hand-add
# ssl_certificate directives yourself first; certbot's --nginx plugin only
# does its automatic rewrite cleanly on a plain HTTP config like this one.
#
# Replace YOUR_DOMAIN below before enabling this site.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    root /opt/ccms/frontend/dist;
    index index.html;

    # REST + WebSocket (/api/v1/status/live) - both live under /api/.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Live view (HLS, relayed on-demand by mediamtx from a camera's RTSP
    # stream - see ccms.live.mediamtx_client). No auth at this layer: the
    # /api/v1/devices/{id}/live endpoint that hands out these URLs is
    # RBAC-gated, but the .m3u8/.ts segment requests themselves are not
    # individually authenticated, matching this app's existing internal-
    # network trust model (same as the campus LAN placement in NFR-11).
    location /live/ {
        proxy_pass http://127.0.0.1:8888/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control no-cache always;
        # mediamtx's HLS server issues its own session redirect
        # (?cookieCheck=1) with a Location header relative to *its own*
        # root (e.g. /live_9/...) - it has no idea Nginx is proxying it
        # under a /live/ prefix, so left alone that redirect 404s here and
        # falls through to the SPA catch-all. Rewrite it back onto /live/.
        proxy_redirect ~^/(live_[^/]+/.*)$ /live/$1;
    }

    # React Router SPA fallback.
    location / {
        try_files $uri /index.html;
    }
}
