# --- Database ---
CCMS_DATABASE_URL=postgresql+psycopg://localhost/ccms

# --- Redis / Celery ---
CCMS_REDIS_BROKER_URL=redis://localhost:6379/0
CCMS_REDIS_BACKEND_URL=redis://localhost:6379/1

# --- Auth ---
CCMS_JWT_SECRET=dev-only-change-me
CCMS_JWT_ALGORITHM=HS256
CCMS_ACCESS_TOKEN_MINUTES=30

# --- Credential encryption (device passwords at rest, NFR-08) ---
# 32 raw bytes, base64-encoded. Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CCMS_CRED_ENC_KEY=changeme-base64-32-bytes

# --- Email (dev: Mailpit, prod: institutional SMTP) ---
CCMS_SMTP_HOST=localhost
CCMS_SMTP_PORT=1025
CCMS_SMTP_USER=
CCMS_SMTP_PASS=
CCMS_SMTP_FROM=ccms@campus.local
CCMS_SMTP_TLS=false

# --- SMS (Twilio-shaped; leave blank to run log-only) ---
CCMS_TWILIO_ACCOUNT_SID=
CCMS_TWILIO_AUTH_TOKEN=
CCMS_TWILIO_FROM_NUMBER=

# --- WhatsApp (generic webhook-shaped; leave blank to run log-only) ---
CCMS_WHATSAPP_WEBHOOK_URL=
CCMS_WHATSAPP_API_TOKEN=

# --- Simulator ---
CCMS_SIM_CONTROL_URL=http://127.0.0.1:9500
CCMS_SIM_RTSP_BASE=rtsp://127.0.0.1:8554

# --- Misc ---
CCMS_SERVE_FRONTEND_DIST=false
CCMS_LOG_LEVEL=INFO
